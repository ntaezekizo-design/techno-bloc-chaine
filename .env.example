# ── Serveur ────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Base de données SQLite ──────────────────────────────
# Laisser vide pour utiliser le chemin par défaut : data/ezekizo.db
DB_PATH=

# ── Session ────────────────────────────────────────────
# IMPORTANT : remplacez par une chaîne aléatoire longue en production !
SESSION_SECRET=your-super-secret-session-key-change-me
