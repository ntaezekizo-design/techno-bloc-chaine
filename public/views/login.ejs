<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion — EZEKIZO</title>
  <meta name="description" content="Connectez-vous à votre compte EZEKIZO">
  <meta name="theme-color" content="#04060f">
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="auth-body">

<div class="auth-page">

  <!-- Left panel — branding -->
  <div class="auth-brand">
    <div class="auth-brand-inner">
      <a href="/" class="auth-logo">
        <div class="logo-icon">⭡</div>
        <div class="logo-text-wrap">
          <div class="logo-text">EZEKIZO</div>
          <div class="logo-tag">EZK · BLOCKCHAIN</div>
        </div>
      </a>
      <h2 class="auth-brand-title">La blockchain<br>de nouvelle génération</h2>
      <p class="auth-brand-sub">Minez, échangez et explorez EZK · Proof-of-Work · 21 000 000 EZK max</p>
      <div class="auth-features">
        <div class="auth-feature"><span class="auth-feature-icon">⛏</span><span>Minage Proof-of-Work</span></div>
        <div class="auth-feature"><span class="auth-feature-icon">💼</span><span>Portefeuilles sécurisés</span></div>
        <div class="auth-feature"><span class="auth-feature-icon">🔎</span><span>Explorateur de blocs</span></div>
        <div class="auth-feature"><span class="auth-feature-icon">📊</span><span>Statistiques en temps réel</span></div>
      </div>
    </div>
  </div>

  <!-- Right panel — form -->
  <div class="auth-panel">
    <div class="auth-card">
      <div class="auth-card-header">
        <h1 class="auth-title">Connexion</h1>
        <p class="auth-subtitle">Accédez à votre espace EZEKIZO</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error">
          <span class="alert-icon">⚠</span>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/login" class="auth-form" autocomplete="on">
        <div class="form-group">
          <label class="form-label" for="login">Nom d'utilisateur ou email</label>
          <input
            class="form-input"
            type="text"
            id="login"
            name="login"
            placeholder="votre_pseudo ou email@exemple.com"
            autocomplete="username"
            required
            autofocus
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="password">
            Mot de passe
            <a href="#" class="form-label-link" tabindex="-1">Mot de passe oublié ?</a>
          </label>
          <div class="input-password-wrap">
            <input
              class="form-input"
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            >
            <button type="button" class="toggle-password" onclick="togglePwd('password')" tabindex="-1" aria-label="Afficher le mot de passe">
              <svg id="eye-password" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-auth">
          Connexion <span class="btn-arrow">→</span>
        </button>
      </form>

      <div class="auth-divider"><span>ou</span></div>

      <div class="auth-footer">
        Pas encore de compte ?
        <a href="/register" class="auth-link">Créer un compte gratuitement</a>
      </div>
    </div>
  </div>

</div>

<script>
function togglePwd(id) {
  const input = document.getElementById(id);
  const icon  = document.getElementById('eye-' + id);
  if (!input) return;
  if (input.type === 'password') {
    input.type = 'text';
    if (icon) icon.style.opacity = '0.5';
  } else {
    input.type = 'password';
    if (icon) icon.style.opacity = '1';
  }
}
</script>

</body>
</html>
