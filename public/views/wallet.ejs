<%- include('partials/header') %>

<!-- ─── Mon solde total ─────────────────────────────── -->
<% const totalBalance = wallets.reduce((sum, w) => sum + parseFloat(w.balance || 0), 0); %>
<div class="hero-banner mb-6" style="padding:28px 36px;">
  <div class="hero-content">
    <div class="hero-badge">💼 MES PORTEFEUILLES</div>
    <div class="hero-title" style="font-size:26px;">
      Solde Total : <span class="hero-brand"><%= totalBalance.toFixed(4) %> EZK</span>
    </div>
    <div class="hero-sub"><%= wallets.length %> portefeuille<%= wallets.length > 1 ? 's' : '' %> dans votre compte</div>
  </div>
  <div class="hero-actions">
    <button onclick="openCreateModal()" class="btn btn-primary btn-lg">+ Nouveau Portefeuille</button>
    <a href="/mine" class="btn btn-secondary btn-lg">⛏ Miner</a>
  </div>
</div>

<div class="grid-2 mb-6">

  <!-- ─── Classement ─────────────────────────────────── -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">🏆 Classement de mes Portefeuilles</span>
      <span class="badge badge-gold"><%= wallets.length %> wallet<%= wallets.length > 1 ? 's' : '' %></span>
    </div>
    <% if (!wallets || wallets.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">💼</div>
        <div class="empty-title">Aucun portefeuille</div>
        <div class="empty-sub">Créez votre premier portefeuille pour commencer</div>
        <button onclick="openCreateModal()" class="btn btn-primary mt-4">+ Créer un portefeuille</button>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table class="data-table">
          <thead><tr><th>#</th><th>Nom</th><th>Adresse</th><th>Solde</th></tr></thead>
          <tbody>
            <% wallets.slice(0,8).forEach((w, i) => { %>
            <tr>
              <td><span class="badge <%= i === 0 ? 'badge-gold' : i === 1 ? 'badge-teal' : 'badge-purple' %>">#<%= i+1 %></span></td>
              <td class="font-bold" style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= w.label %></td>
              <td>
                <span class="font-mono text-sm text-cyan" onclick="copyToClipboard('<%= w.address %>','Adresse')" style="cursor:pointer" title="Copier : <%= w.address %>">
                  <%= w.address.substring(0,14) %>…
                </span>
              </td>
              <td class="font-bold text-green"><%= parseFloat(w.balance).toFixed(4) %> EZK</td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- ─── Créer un portefeuille (inline si vide) ──────── -->
  <div class="card">
    <div class="card-header">
      <span class="card-title">✨ Nouveau Portefeuille</span>
    </div>
    <div class="form-group">
      <label class="form-label">Nom du Portefeuille</label>
      <input type="text" class="form-input" id="wallet-label"
             placeholder="ex: Minage Principal, Épargne…"
             value="Mon Portefeuille" maxlength="50">
    </div>
    <div class="alert alert-info" style="margin-bottom:18px;">
      <span>ℹ</span> Une adresse EZK unique sera générée automatiquement et associée à votre compte.
    </div>
    <button onclick="createWallet()" class="btn btn-primary btn-full" id="create-btn">
      💰 Générer le Portefeuille
    </button>
    <div id="new-wallet-result" style="display:none;margin-top:20px;">
      <div class="alert alert-success" style="background:rgba(0,230,118,0.07);border:1px solid rgba(0,230,118,0.2);color:var(--green-400);">
        <span>✅</span> Portefeuille créé avec succès !
      </div>
      <div class="form-group mt-4" style="margin-bottom:0">
        <label class="form-label">Votre nouvelle adresse</label>
        <div class="hash-display" id="new-wallet-address"
             style="cursor:pointer;word-break:break-all;"
             onclick="copyToClipboard(this.textContent.trim(),'Adresse')">—</div>
        <div class="text-sm text-muted mt-2">👆 Cliquez pour copier</div>
      </div>
    </div>
  </div>

</div>

<!-- ─── Grille de portefeuilles ─────────────────────── -->
<div>
  <div class="flex justify-between items-center mb-4" style="gap:12px;flex-wrap:wrap;">
    <h2 style="font-size:15px;font-weight:700;color:var(--text-200);">
      💼 Tous mes portefeuilles
      <span class="badge badge-gold" style="margin-left:8px;"><%= wallets ? wallets.length : 0 %></span>
    </h2>
    <input type="text" class="form-input" id="wallet-search"
           placeholder="🔍 Rechercher par nom ou adresse…"
           style="max-width:260px;"
           oninput="filterWallets(this.value)">
  </div>

  <% if (!wallets || wallets.length === 0) { %>
    <div class="card" style="text-align:center;padding:60px 24px;">
      <div class="empty-icon">💼</div>
      <div class="empty-title">Aucun portefeuille</div>
      <div class="empty-sub">Créez votre premier portefeuille ci-dessus pour commencer à miner de l'EZK.</div>
    </div>
  <% } else { %>
    <div class="wallet-grid" id="wallet-grid">
      <% wallets.forEach(w => { %>
      <div class="wallet-card" data-address="<%= w.address %>" data-label="<%= w.label %>">
        <div class="wallet-header">
          <div class="wallet-icon">💼</div>
          <div style="flex:1;min-width:0;">
            <div class="wallet-label"><%= w.label %></div>
            <div class="wallet-address font-mono text-sm text-cyan"
                 onclick="copyToClipboard('<%= w.address %>','Adresse')"
                 style="cursor:pointer;"
                 title="Copier l'adresse">
              <%= w.address.substring(0,20) %>…
            </div>
          </div>
        </div>
        <div class="wallet-balance text-green"><%= parseFloat(w.balance).toFixed(8) %> EZK</div>
        <div class="wallet-actions">
          <a href="/transactions?from=<%= w.address %>" class="btn btn-secondary btn-sm">↗ Envoyer</a>
          <a href="/transactions?address=<%= w.address %>" class="btn btn-ghost btn-sm">📋 Historique</a>
          <button onclick="copyToClipboard('<%= w.address %>','Adresse')" class="btn btn-ghost btn-sm" title="Copier l'adresse">📋</button>
        </div>
      </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- ─── Modal créer portefeuille ─────────────────────── -->
<div class="modal-overlay" id="create-modal">
  <div class="modal">
    <div class="modal-title">✨ Nouveau Portefeuille</div>
    <div class="form-group">
      <label class="form-label">Nom du Portefeuille</label>
      <input type="text" class="form-input" id="modal-wallet-label"
             placeholder="ex: Minage Principal, Épargne EZK…"
             value="Mon Portefeuille" maxlength="50">
    </div>
    <div class="alert alert-info">
      <span>ℹ</span> Une adresse EZK unique sera générée et liée à votre compte.
    </div>
    <div class="flex gap-3 mt-4">
      <button onclick="closeCreateModal()" class="btn btn-ghost btn-full">Annuler</button>
      <button onclick="createWalletModal()" class="btn btn-primary btn-full" id="modal-create-btn">
        💰 Générer
      </button>
    </div>
  </div>
</div>

<style>
.empty-state { text-align:center; padding:48px 24px; }
.empty-icon  { font-size:48px; margin-bottom:12px; }
.empty-title { font-size:18px; font-weight:700; color:var(--text-200); margin-bottom:6px; }
.empty-sub   { font-size:13px; color:var(--text-600); line-height:1.6; }
</style>

<script>
/* ─── Create wallet (inline form) ─────────────────────── */
function createWallet() {
  const label = (document.getElementById('wallet-label').value || '').trim() || 'Mon Portefeuille';
  _doCreate(label, 'create-btn', (address) => {
    document.getElementById('new-wallet-result').style.display = 'block';
    document.getElementById('new-wallet-address').textContent  = address;
  });
}

/* ─── Create wallet (modal) ───────────────────────────── */
function createWalletModal() {
  const label = (document.getElementById('modal-wallet-label').value || '').trim() || 'Mon Portefeuille';
  _doCreate(label, 'modal-create-btn', () => {});
}

function _doCreate(label, btnId, onSuccess) {
  const btn = document.getElementById(btnId);
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Génération…'; }

  fetch('/api/wallet', {
    method:  'POST',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify({ label })
  })
  .then(r => r.json())
  .then(data => {
    if (btn) { btn.disabled = false; btn.innerHTML = '💰 Générer'; }
    if (data.success) {
      onSuccess(data.wallet.address);
      showToast('✅ Portefeuille créé ! Rechargement…', 'success');
      closeCreateModal();
      setTimeout(() => location.reload(), 1600);
    } else {
      showToast('❌ ' + data.error, 'error');
    }
  })
  .catch(() => {
    if (btn) { btn.disabled = false; btn.innerHTML = '💰 Générer'; }
    showToast('❌ Erreur réseau', 'error');
  });
}

/* ─── Modal ───────────────────────────────────────────── */
function openCreateModal() {
  document.getElementById('create-modal').classList.add('open');
  setTimeout(() => document.getElementById('modal-wallet-label').focus(), 100);
}
function closeCreateModal() {
  document.getElementById('create-modal').classList.remove('open');
}
document.getElementById('create-modal').addEventListener('click', (e) => {
  if (e.target === e.currentTarget) closeCreateModal();
});

/* ─── Search filter ───────────────────────────────────── */
function filterWallets(q) {
  const lower = q.toLowerCase();
  document.querySelectorAll('.wallet-card').forEach(card => {
    const match = card.dataset.address.toLowerCase().includes(lower)
               || card.dataset.label.toLowerCase().includes(lower);
    card.style.display = match ? '' : 'none';
  });
}
</script>

<%- include('partials/footer') %>
